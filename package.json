{
  "name": "raspy-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "serve:dev": "cross-env VUE_APP_ENV=dev vite",
    "serve:prod": "cross-env VUE_APP_ENV=prod vite",
    "build": "node scripts/check-api.mjs && vue-tsc --noEmit && cross-env VUE_APP_ENV=prod vite build && node scripts/build-legal.mjs",
    "build:dev": "cross-env VUE_APP_ENV=dev vite build",
    "preview": "vite preview --port 8081",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --ext .js,.ts,.vue src",
    "api:check": "node scripts/check-api.mjs",
    "api:sync": "node scripts/sync-api.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@capgo/capacitor-social-login": "^8.7.6",
    "@sentry/vue": "^8.38.0",
    "@stomp/stompjs": "^7.1.1",
    "@zumer/snapdom": "3.3.7",
    "axios": "^1.9.0",
    "chart.js": "^4.5.0",
    "lucide-vue-next": "^0.460.0",
    "match-kakao-login": "file:native/kakao-login",
    "phaser": "3.88.2",
    "vue": "^3.5.18",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^8.7.1",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "node": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {}
  },
  "type": "module"
}
