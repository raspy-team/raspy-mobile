{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/m/:id(\\d+)",
      "destination": "https://raspy-api.fly.dev/m/:id"
    },
    {
      "source": "/m/:id(\\d+)/:file(og.png|story.png)",
      "destination": "https://raspy-api.fly.dev/m/:id/:file"
    },
    {
      "source": "/:path((?!m/|assets/|\\.well-known/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(kakaotalk-scrap|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|Yeti|Daumoa|line-poker|BandBot|redditbot|Pinterestbot|SkypeUriPreview|Snap URL Preview|Mastodon|Bluesky|Iframely|Embedly).*"
        }
      ],
      "destination": "https://raspy-api.fly.dev/preview/:path"
    },
    {
      "source": "/((?!\\.well-known/).*)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
